{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    // "module": "es6",
    "module": "esnext",
    "target": "es6",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    // "moduleResolution": "node",
    "moduleResolution": "bundler",
    // "baseUrl": ".",
    "paths": {
      "*": ["./src/*"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}